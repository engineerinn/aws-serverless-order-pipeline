{
  "Comment": "E-Commerce Order Processing Workflow",
  "StartAt": "ParseAndValidate",
  "States": {

    "ParseAndValidate": {
      "Type": "Task",
      "Resource": "${ParseLambdaArn}",
      "TimeoutSeconds": 130,
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"],
          "MaxAttempts": 2,
          "IntervalSeconds": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [{"ErrorEquals": ["States.ALL"], "Next": "NotifyFailure", "ResultPath": "$.error"}],
      "Next": "EnrichOrders"
    },

    "EnrichOrders": {
      "Type": "Task",
      "Resource": "${EnrichLambdaArn}",
      "TimeoutSeconds": 70,
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"],
          "MaxAttempts": 2,
          "IntervalSeconds": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [{"ErrorEquals": ["States.ALL"], "Next": "NotifyFailure", "ResultPath": "$.error"}],
      "Next": "SaveToDynamoDB"
    },

    "SaveToDynamoDB": {
      "Type": "Task",
      "Resource": "${SaveLambdaArn}",
      "TimeoutSeconds": 130,
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException", "ProvisionedThroughputExceededException"],
          "MaxAttempts": 3,
          "IntervalSeconds": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [{"ErrorEquals": ["States.ALL"], "Next": "NotifyFailure", "ResultPath": "$.error"}],
      "Next": "ArchiveToS3"
    },

    "ArchiveToS3": {
      "Type": "Task",
      "Resource": "${ArchiveLambdaArn}",
      "TimeoutSeconds": 70,
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"],
          "MaxAttempts": 2,
          "IntervalSeconds": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [{"ErrorEquals": ["States.ALL"], "Next": "NotifyFailure", "ResultPath": "$.error"}],
      "Next": "NotifySuccess"
    },

    "NotifySuccess": {
      "Type": "Task",
      "Resource": "${NotifyLambdaArn}",
      "Parameters": {"status": "SUCCESS", "summary.$": "$.summary"},
      "TimeoutSeconds": 40,
      "Retry": [
        {
          "ErrorEquals": ["States.ALL"],
          "MaxAttempts": 2,
          "IntervalSeconds": 2,
          "BackoffRate": 2
        }
      ],
      "End": true
    },

    "NotifyFailure": {
      "Type": "Task",
      "Resource": "${NotifyLambdaArn}",
      "Parameters": {"status": "FAILURE", "error.$": "$.error"},
      "TimeoutSeconds": 40,
      "Retry": [
        {
          "ErrorEquals": ["States.ALL"],
          "MaxAttempts": 2,
          "IntervalSeconds": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [{"ErrorEquals": ["States.ALL"], "Next": "PipelineFailed", "ResultPath": "$.notifyError"}],
      "Next": "PipelineFailed"
    },

    "PipelineFailed": {
      "Type": "Fail",
      "Error": "OrderPipelineFailed",
      "Cause": "One or more pipeline steps failed — check CloudWatch logs"
    }
  }
}
