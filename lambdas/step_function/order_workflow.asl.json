{

  "Comment": "E-Commerce Order Processing Workflow",
  "StartAt": "ParseAndValidate",
  "States": {

    "ParseAndValidate": {
      "Type": "Task",
      "Resource": "${ParseLambdaArn}",
      "Retry": [{"ErrorEquals": ["Lambda.ServiceException"], "MaxAttempts": 2, "IntervalSeconds": 2}],
      "Catch": [{"ErrorEquals": ["States.ALL"], "Next": "NotifyFailure", "ResultPath": "$.error"}],
      "Next": "EnrichOrders"
    },

    "EnrichOrders": {
      "Type": "Task",
      "Resource": "${EnrichLambdaArn}",
      "Catch": [{"ErrorEquals": ["States.ALL"], "Next": "NotifyFailure", "ResultPath": "$.error"}],
      "Next": "SaveToDynamoDB"
    },

    "SaveToDynamoDB": {
      "Type": "Task",
      "Resource": "${SaveLambdaArn}",
      "Catch": [{"ErrorEquals": ["States.ALL"], "Next": "NotifyFailure", "ResultPath": "$.error"}],
      "Next": "ArchiveToS3"
    },

    "ArchiveToS3": {
      "Type": "Task",
      "Resource": "${ArchiveLambdaArn}",
      "Next": "NotifySuccess"
    },

    "NotifySuccess": {
      "Type": "Task",
      "Resource": "${NotifyLambdaArn}",
      "Parameters": {"status": "SUCCESS", "summary.$": "$.summary"},
      "End": true
    },

    "NotifyFailure": {
      "Type": "Task",
      "Resource": "${NotifyLambdaArn}",
      "Parameters": {"status": "FAILURE", "error.$": "$.error"},
      "Next": "PipelineFailed"
    },

    "PipelineFailed": {
      "Type": "Fail",
      "Error": "OrderPipelineFailed",
      "Cause": "One or more pipeline steps failed — check CloudWatch logs"
    }
  }
}
